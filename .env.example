# ===== SERVER =====
# production enables the startup gates: no stub / sandbox money-moving
# integrations, KMS-only PII keys. Staging must NOT run as production
# with sandbox providers — it will (correctly) refuse to start.
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ===== DATABASE =====
DATABASE_URL="postgresql://flexpay:securepass@localhost:5432/flexpay?schema=public"

# ===== REDIS =====
REDIS_URL="redis://localhost:6379"
REDIS_OTP_TTL=300
REDIS_RATE_LIMIT_TTL=3600

# ===== JWT =====
# REQUIRED — there is no default in any environment. The server refuses to
# start if a secret is missing, shorter than 32 characters, a placeholder,
# a value that has ever appeared in this repository, or if access and
# refresh share the same value. Generate each one separately with:
#   openssl rand -hex 48
# Never commit real values. Lifetimes: access 1m–1h, refresh 1h–30d.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d
# Comma-separated JWT subjects allowed to use role=admin. Empty = every
# admin-role token is refused (there is no admin login yet).
ADMIN_SUBJECT_IDS=

# ===== TWILIO =====
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
TWILIO_PHONE_NUMBER="+1234567890"

# ===== NYMCARD =====
NYMCARD_API_KEY="nym_live_xxxxxxxxxxxxxxxxxxxx"
NYMCARD_API_BASE="https://api.nymcard.com/v1"
# nCore authenticates webhooks with Basic Auth (+ an optional custom
# header) — there is no body signature. Generate the password with
# `openssl rand -hex 32` (min 32 chars) and register the same values in
# nCore. Unset or weak → every NymCard webhook is refused (503) in every
# environment. Never commit real values.
NYMCARD_WEBHOOK_BASIC_USER=
NYMCARD_WEBHOOK_BASIC_PASSWORD=
# Optional extra header, e.g. NAME=apikey (both or neither, value min 16 chars).
NYMCARD_WEBHOOK_HEADER_NAME=
NYMCARD_WEBHOOK_HEADER_VALUE=

# ===== MONEYHASH =====
MONEYHASH_API_KEY="mh_live_xxxxxxxxxxxxxxxxxxxx"
MONEYHASH_API_BASE="https://api.moneyhash.com/v1"
# Organisation webhook signing key from the MoneyHash dashboard (v3
# signatures, `MoneyHash-Signature: t=…,v3=…`). Unset or weak → every
# MoneyHash webhook is refused (503) in every environment.
MONEYHASH_WEBHOOK_SECRET=
# Max age of the signed timestamp `t` (60–900s).
MONEYHASH_WEBHOOK_TOLERANCE_SECONDS=300

# ===== FLEXXPAY =====
FLEXXPAY_API_KEY="fp_live_xxxxxxxxxxxxxxxxxxxx"
FLEXXPAY_API_BASE="https://api.flexxpay.com/v1"
FLEXXPAY_REDIRECT_URL="https://flexpay.ae/ewa/success"
# HMAC-SHA256 key for `x-flexxpay-signature` (hex of the raw body, min 16
# chars). Unset or weak → every FlexxPay webhook is refused (503).
FLEXXPAY_WEBHOOK_SECRET=

# ===== BILLER RAIL =====
# HMAC-SHA256 key for `x-biller-signature` (hex of the raw body, min 16
# chars). Unset or weak → every biller webhook is refused (503).
BILLER_WEBHOOK_SECRET=

# ===== FIREBASE =====
FIREBASE_PROJECT_ID="flexpay-prod"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxx@flexpay-prod.iam.gserviceaccount.com"

# ===== SECURITY =====
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# How long an accepted FlexxPay / biller / NymCard-transaction delivery is
# remembered to refuse an identical replay (3600–2592000s; default 7 days).
WEBHOOK_REPLAY_TTL_SECONDS=604800

# ===== APP =====
APP_NAME="FlexPay"
APP_URL="https://api.flexpay.ae"
SUPPORT_EMAIL="support@flexpay.ae"
CASHBACK_BASIC_RATE=0.01
CASHBACK_LUXURY_RATE=0.025
CASHBACK_BASIC_CAP=100
CASHBACK_LUXURY_CAP=300
PHYSICAL_CARD_FEE=30
P2P_TRANSFER_FEE=2
REMITTANCE_FX_SPREAD=0.005
REMITTANCE_FEE_PERCENT=0.006
